{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:sync:android": "npm run build && npx cap sync android",
    "mobile:android:bundle": "npm run mobile:sync:android && cd android && ./gradlew bundleRelease",
    "mobile:android:signing:setup": "./scripts/setup-android-signing.sh",
    "mobile:android:bundle:signed": "./scripts/build-android-release.sh",
    "mobile:android:apk": "npm run mobile:sync:android && cd android && ./gradlew assembleRelease",
    "mobile:android:open": "npx cap open android",
    "mobile:ios:open": "npx cap open ios",
    "docs:sync": "./scripts/update-platform-doc.sh",
    "docs:sync:install": "./scripts/install-doc-sync-cron.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@supabase/supabase-js": "^2.57.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "onesignal-cordova-plugin": "^5.2.15",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
