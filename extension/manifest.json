{
  "manifest_version": 3,
  "name": "ProfilePush Apply",
  "version": "0.1.0",
  "description": "Fill job applications for your profiles in one click. You review and press Apply.",
  "key": "",
  "permissions": ["storage", "sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "ProfilePush Apply" },
  "externally_connectable": { "matches": ["https://profilepush.ai/*", "https://*.profilepush.pages.dev/*", "http://localhost:5173/*"] },
  "icons": { "128": "icon-128.png" }
}
